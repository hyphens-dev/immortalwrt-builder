# network — ImmortalWrt PVE Builder rootfs overlay
# 占位符由 scripts/build.sh 依据 config.yml 的 build.* 渲染。
#
# 布局 router : eth0 -> wan，eth1 -> lan
#              （PVE: net0=vmbr0 作 WAN，net1=vmbr1 作 LAN）
# 布局 single : eth0 -> lan（单网卡旁路由）
#
# 若实际只有一块网卡（eth1 不存在），首次启动的 /etc/uci-defaults/99-pve-defaults
# 会自动把 eth0 接到 br-lan 并把 wan 置为 none，避免整机失联。

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option ula_prefix 'fd87:4c02:27d6::/48'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
@LAN_PORTS@

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ip6assign '60'
@LAN_ADDRS@

@WAN_BLOCK@