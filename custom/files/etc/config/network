# network — ImmortalWrt PVE Builder rootfs overlay
# proto/地址等占位符由 scripts/build.sh 依据 config.yml 渲染。
# eth0 = PVE virtio-net 网卡。
#
# 默认 proto=dhcp：接上 PVE 网桥后由上游 DHCP 分配地址，开机即可 SSH/Web。
# 想当旁路由固定 IP，把 config.yml 的 build.net_mode 改为 static 并设置
# build.lan_ip / build.lan_gateway。

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fdp0:5ee:dead::/48'
	option packet_steering '1'

config interface 'lan'
	option device 'br-lan'
	option proto '@LAN_PROTO@'
@LAN_STANZA@