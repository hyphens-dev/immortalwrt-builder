# Base target configuration for ImmortalWrt on x86_64 (PVE / KVM guest)
# =============================================================================
# Only OpenWrt top-level symbols belong here. Device images are enabled so the
# release can ship combined squashfs + ext4 images for both BIOS and UEFI.
# =============================================================================

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# --- Image types -------------------------------------------------------------
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_ISO_IMAGES=y
CONFIG_VMDK_IMAGES=y
CONFIG_VDI_IMAGES=y

# Partition sizes: 16 MiB boot, 512 MiB rootfs
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# --- Build behaviour ---------------------------------------------------------
# Keep the build deterministic and reasonably fast on CI runners
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_IMAGEOPT=y
# LTO is left off by default (kernel.lto in config.yml can enable it)
# CONFIG_USE_LTO is not set