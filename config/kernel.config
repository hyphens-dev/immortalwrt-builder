# Kernel configuration for ImmortalWrt on x86_64 (PVE/KVM guest)
# =============================================================================
# IMPORTANT: these are OpenWrt top-level symbols (CONFIG_KERNEL_*), which is the
# only kernel namespace the OpenWrt .config understands. Raw Linux Kconfig
# symbols (CONFIG_VIRTIO, CONFIG_TCP_CONG_BBR, CONFIG_HZ_1000, ...) are silently
# discarded by `make defconfig` and must not be used here.
#
# Device/filesystem support (VirtIO, virtiofs, 9p, fuse, ...) is delivered as
# kmod-* packages - see config/packages.config and the feature toggles in
# config.yml. Only the kernel *features* OpenWrt exposes belong in this file.
# =============================================================================

# --- Core subsystems ---------------------------------------------------------
CONFIG_KERNEL_DEVTMPFS=y
CONFIG_KERNEL_DEVTMPFS_MOUNT=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_PRINTK=y
CONFIG_KERNEL_PRINTK_TIME=y
CONFIG_KERNEL_MAGIC_SYSRQ=y
CONFIG_KERNEL_COREDUMP=y
CONFIG_KERNEL_ELF_CORE=y
CONFIG_KERNEL_PROC_PAGE_MONITOR=y
CONFIG_KERNEL_PROC_KCORE=y
CONFIG_KERNEL_DETECT_HUNG_TASK=y
CONFIG_KERNEL_AIO=y
CONFIG_KERNEL_IO_URING=y
CONFIG_KERNEL_POSIX_MQUEUE=y
CONFIG_KERNEL_AUDIT=y
CONFIG_KERNEL_KEYS=y

# --- Optimisation (the only knobs OpenWrt actually exposes) ------------------
# -O2 for the kernel instead of -Os
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE is not set

# --- Virtualisation / container prerequisites --------------------------------
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_PID_NS=y
CONFIG_KERNEL_IPC_NS=y
CONFIG_KERNEL_UTS_NS=y
CONFIG_KERNEL_USER_NS=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_SECCOMP_FILTER=y

# --- Networking --------------------------------------------------------------
CONFIG_KERNEL_IPV6=y
CONFIG_KERNEL_IPV6_MULTIPLE_TABLES=y
CONFIG_KERNEL_IPV6_SUBTREES=y
CONFIG_KERNEL_NET_L3_MASTER_DEV=y

# --- Filesystem --------------------------------------------------------------
CONFIG_KERNEL_SQUASHFS_XATTR=y
CONFIG_KERNEL_TMPFS_POSIX_ACL=y
CONFIG_KERNEL_FS_POSIX_ACL=y
CONFIG_KERNEL_EXT4_FS_POSIX_ACL=y
CONFIG_KERNEL_EXT4_FS_SECURITY=y