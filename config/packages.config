# Package selection for ImmortalWrt on x86_64 / PVE-KVM guest
# =============================================================================
# Every package name below was verified against the openwrt-24.10 package
# indexes and package/kernel/linux/modules/*.mk in the upstream tree.
#
# NOTE ON VIRTIO: virtio-net, virtio-blk, virtio-scsi, virtio-balloon,
# virtio-rng, virtio-console, virtio-mmio and virtio-pci are built into the
# x86/64 target kernel (target/linux/x86/64/config-6.6) - there is no
# kmod-virtio-* package, so nothing needs to be selected for them.
#
# Kernel features that OpenWrt exposes as CONFIG_KERNEL_* live in
# config/kernel.config, not here.
# =============================================================================

# --- LuCI --------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-material=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# --- VirtIO-FS (PVE host directory sharing) ----------------------------------
# kmod-fs-virtiofs is not shipped by upstream 24.10; it is provided by this
# repository (package/kernel/linux/modules/fs-virtiofs.mk), which build.sh and
# the CI workflow install into the source tree.
CONFIG_PACKAGE_kmod-fs-virtiofs=y
CONFIG_PACKAGE_kmod-fuse=y

# --- 9p / virtio-9p (alternative host-guest sharing) -------------------------
CONFIG_PACKAGE_kmod-fs-9p=y
CONFIG_PACKAGE_kmod-9pnet=y
CONFIG_PACKAGE_kmod-9pvirtio=y

# --- Networking / firewall ---------------------------------------------------
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-tun=y

# --- Performance -------------------------------------------------------------
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_irqbalance=y

# --- Side router extras ------------------------------------------------------
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-smartdns=y

# --- System / diagnostics ----------------------------------------------------
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_vim-fuller=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_procps-ng=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fdisk=y